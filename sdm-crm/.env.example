# App
NODE_ENV=production
PORT=3000
APP_NAME=SDM-CRM
BASE_URL=https://yourdomain.com

# JWT
JWT_SECRET=replace_with_a_very_long_random_string_min_64_chars
JWT_EXPIRES_IN=8h

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sdm_crm
DB_USER=sdm_user
DB_PASSWORD=replace_with_strong_password
DB_POOL_MAX=10
DB_POOL_MIN=2

# File Storage
UPLOADS_DIR=/home/username/sdm-crm/uploads

# Logging
LOG_LEVEL=info
LOG_DIR=/home/username/sdm-crm/logs
